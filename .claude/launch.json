{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "api", "dev"],
      "port": 3000
    },
    {
      "name": "worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "api", "worker"],
      "port": 3999
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "mobile", "exec", "expo", "start", "--web", "--port", "8082"],
      "port": 8082
    },
    {
      "name": "mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "mobile", "start"],
      "port": 8081
    },
    {
      "name": "supplier-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@adclub/supplier-web", "dev"],
      "port": 5175
    },
    {
      "name": "supplier-web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@adclub/supplier-web", "preview"],
      "port": 5175
    },
    {
      "name": "supplier-lan",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:lan"],
      "port": 5480
    },
    {
      "name": "admin-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@adclub/admin-web", "dev"],
      "port": 5174
    }
  ]
}
