# Copy to .env and adjust as needed. Never commit the real .env file.

NODE_ENV=development

# apps/api
PORT=3000
# error | warn | log | debug | verbose (default: log)
LOG_LEVEL=debug

# infra/docker/compose.dev.yml — PostgreSQL
POSTGRES_USER=adclub
POSTGRES_PASSWORD=adclub
POSTGRES_DB=adclub
POSTGRES_PORT=5432
DATABASE_URL=postgres://adclub:adclub@localhost:5432/adclub

# infra/docker/compose.dev.yml — Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# infra/docker/compose.dev.yml — Meilisearch
MEILISEARCH_PORT=7700
MEILI_MASTER_KEY=adclub-dev-master-key
MEILISEARCH_URL=http://localhost:7700

# infra/docker/compose.dev.yml — MinIO (S3-compatible storage)
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=adclub
S3_SECRET_KEY=adclub-dev-secret
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=adclub-dev
# Optional, default: us-east-1 (MinIO ignores it; kept for compatibility with real S3)
# S3_REGION=us-east-1

# apps/api — client policy (ARCHITECTURE 7.4, served at GET /meta/client-policy).
# Minimum supported MAJOR.MINOR.PATCH per platform (default 0.0.0 = everyone).
# A known client below its minimum gets CLIENT_UPDATE_REQUIRED (HTTP 426) on
# every route except /health and /meta/client-policy. Restart the API after
# changing. Moves to the settings table in TASK-007.
# CLIENT_MIN_VERSION_IOS=0.0.0
# CLIENT_MIN_VERSION_ANDROID=0.0.0
# CLIENT_MIN_VERSION_SUPPLIER_WEB=0.0.0
# CLIENT_MIN_VERSION_ADMIN_WEB=0.0.0
# Optional overrides of the "update required" text (defaults are built in).
# CLIENT_UPDATE_MESSAGE_RU=
# CLIENT_UPDATE_MESSAGE_KK=
# CLIENT_UPDATE_MESSAGE_EN=

# apps/api — client IP behind a reverse proxy (Express "trust proxy"):
# false (default) = the socket address, a number of trusted hops, or
# addresses/subnets. Rate limits by IP depend on it (ARCHITECTURE 4.5 I36).
# TRUST_PROXY=false

# apps/api — login codes (ARCHITECTURE 8.1, 4.5). Restart the API after changing.
# Channels: only "test" exists until TASK-026 (nothing is sent; refused when
# NODE_ENV=production).
# LOGIN_CODE_CHANNELS=test
# Make test channels report a delivery failure: whatsapp, sms or whatsapp,sms
# LOGIN_CODE_TEST_FAILING_CHANNELS=
# Show sent codes at GET /dev/login-codes. Default: true for development/test,
# false otherwise; refused when NODE_ENV=production.
# LOGIN_CODE_DEV_OUTBOX=true
# HMAC key for stored codes, >= 32 chars. Required outside development/test.
# LOGIN_CODE_HASH_SECRET=
# Thresholds (defaults shown). Windows are in seconds; SMS limits are per 24 h.
# LOGIN_CODE_LENGTH=6
# LOGIN_CODE_TTL_SECONDS=300
# LOGIN_CODE_MAX_ATTEMPTS=5
# LOGIN_CODE_RESEND_INTERVAL_SECONDS=60
# LOGIN_CODE_VERIFY_FREE_FAILURES=2
# LOGIN_CODE_VERIFY_DELAY_BASE_SECONDS=2
# LOGIN_CODE_REQUESTS_PER_PHONE=5
# LOGIN_CODE_REQUESTS_PER_PHONE_WINDOW_SECONDS=3600
# LOGIN_CODE_REQUESTS_PER_IP=30
# LOGIN_CODE_REQUESTS_PER_IP_WINDOW_SECONDS=3600
# LOGIN_CODE_VERIFICATIONS_PER_PHONE=15
# LOGIN_CODE_VERIFICATIONS_PER_PHONE_WINDOW_SECONDS=3600
# LOGIN_CODE_SMS_PER_PHONE_DAILY=5
# LOGIN_CODE_SMS_PER_IP_DAILY=10

# apps/api — browser origins of the web clients (CORS and cookie sessions;
# ARCHITECTURE 4.6). Comma-separated, scheme://host[:port], no path.
# Default in development/test: the Vite dev servers below (localhost and
# 127.0.0.1, ports 5175 and 5174); elsewhere: none — set them explicitly.
# SUPPLIER_WEB_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# ADMIN_WEB_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# apps/api — sessions (ARCHITECTURE 8.2, 4.6). Restart the API after changing.
# HMAC key of access and refresh tokens, >= 32 chars. Required outside
# development/test. Changing it ends every session.
# SESSION_TOKEN_SECRET=
# Lifetimes in seconds (defaults shown): access token 15 min; mobile 90 days
# and supplier cabinet 180 days, both extended on every refresh; admin panel
# 12 hours from sign-in, never extended.
# SESSION_ACCESS_TOKEN_TTL_SECONDS=900
# SESSION_MOBILE_TTL_SECONDS=7776000
# SESSION_SUPPLIER_WEB_TTL_SECONDS=15552000
# SESSION_ADMIN_WEB_TTL_SECONDS=43200
# A refresh token just replaced still returns the same new pair for this long
# (retries, concurrent refreshes); later it counts as reuse and ends the session.
# SESSION_REFRESH_REUSE_GRACE_SECONDS=60
# Refresh rate limits (windows in seconds).
# SESSION_REFRESH_PER_SESSION=30
# SESSION_REFRESH_PER_SESSION_WINDOW_SECONDS=3600
# SESSION_REFRESH_PER_IP=600
# SESSION_REFRESH_PER_IP_WINDOW_SECONDS=3600

# apps/admin-web, apps/supplier-web
VITE_API_URL=http://localhost:3000

# apps/mobile reads its own apps/mobile/.env — see apps/mobile/.env.example
