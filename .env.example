# Copy to .env and adjust as needed. Never commit the real .env file.

NODE_ENV=development

# apps/api
PORT=3000
# error | warn | log | debug | verbose (default: log)
LOG_LEVEL=debug

# infra/docker/compose.dev.yml — PostgreSQL
POSTGRES_USER=adclub
POSTGRES_PASSWORD=adclub
POSTGRES_DB=adclub
POSTGRES_PORT=5432
DATABASE_URL=postgres://adclub:adclub@localhost:5432/adclub

# infra/docker/compose.dev.yml — Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# infra/docker/compose.dev.yml — Meilisearch
MEILISEARCH_PORT=7700
MEILI_MASTER_KEY=adclub-dev-master-key
MEILISEARCH_URL=http://localhost:7700

# infra/docker/compose.dev.yml — MinIO (S3-compatible storage)
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=adclub
S3_SECRET_KEY=adclub-dev-secret
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=adclub-dev
# Optional, default: us-east-1 (MinIO ignores it; kept for compatibility with real S3)
# S3_REGION=us-east-1

# apps/api — client policy (ARCHITECTURE 7.4, served at GET /meta/client-policy).
# Minimum supported MAJOR.MINOR.PATCH per platform (default 0.0.0 = everyone).
# A known client below its minimum gets CLIENT_UPDATE_REQUIRED (HTTP 426) on
# every route except /health and /meta/client-policy. Restart the API after
# changing. Moves to the settings table in TASK-007.
# CLIENT_MIN_VERSION_IOS=0.0.0
# CLIENT_MIN_VERSION_ANDROID=0.0.0
# CLIENT_MIN_VERSION_SUPPLIER_WEB=0.0.0
# CLIENT_MIN_VERSION_ADMIN_WEB=0.0.0
# Optional overrides of the "update required" text (defaults are built in).
# CLIENT_UPDATE_MESSAGE_RU=
# CLIENT_UPDATE_MESSAGE_KK=
# CLIENT_UPDATE_MESSAGE_EN=

# apps/admin-web, apps/supplier-web
VITE_API_URL=http://localhost:3000

# apps/mobile reads its own apps/mobile/.env — see apps/mobile/.env.example
