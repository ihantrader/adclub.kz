# Copy to .env and adjust as needed. Never commit the real .env file.

NODE_ENV=development

# apps/api
PORT=3000
# error | warn | log | debug | verbose (default: log)
LOG_LEVEL=debug

# infra/docker/compose.dev.yml — PostgreSQL
POSTGRES_USER=adclub
POSTGRES_PASSWORD=adclub
POSTGRES_DB=adclub
POSTGRES_PORT=5432
DATABASE_URL=postgres://adclub:adclub@localhost:5432/adclub

# infra/docker/compose.dev.yml — Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# infra/docker/compose.dev.yml — Meilisearch: the search index of the catalog
# (TASK-045). Without MEILISEARCH_URL the users' search runs on PostgreSQL.
# The API and the worker use MEILISEARCH_API_KEY, or the master key when it
# is unset; MEILISEARCH_INDEX — the name of the index (default catalog_items).
MEILISEARCH_PORT=7700
MEILI_MASTER_KEY=adclub-dev-master-key
MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=
# MEILISEARCH_INDEX=catalog_items

# infra/docker/compose.dev.yml — MinIO (S3-compatible storage)
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=adclub
S3_SECRET_KEY=adclub-dev-secret
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=adclub-dev
# Optional, default: us-east-1 (MinIO ignores it; kept for compatibility with real S3)
# S3_REGION=us-east-1

# apps/api — product thresholds, limits, time frames and texts are NOT
# environment variables: they are settings stored in the database
# (ARCHITECTURE 14, 4.11) — login codes, sessions, sign-in steps, the second
# factor, the client policy (minimum versions, update text) and the rest.
# See and change them with the operator command (applies within 30 s, no
# restart):  pnpm --filter api operator settings:list
#            pnpm --filter api operator settings:set <key> <value> --reason "<why>"
# or in the admin API (GET/PUT /admin/settings…). Former variables such as
# LOGIN_CODE_LENGTH or CLIENT_MIN_VERSION_IOS are ignored (the API warns).

# apps/api — the admin panel version this deployment serves (a release fact,
# not a setting): the admin panel minimum version can't be set above it.
# Required outside development/test; default in development/test: the
# version in apps/admin-web/package.json.
# ADMIN_WEB_RELEASE_VERSION=0.1.0

# apps/api — client IP behind a reverse proxy (Express "trust proxy"):
# false (default) = the socket address, a number of trusted hops, or
# addresses/subnets. Rate limits by IP depend on it (ARCHITECTURE 4.5 I36).
# On staging it is the proxy's fixed address in the stack's network — one
# trusted hop, by address (infra/docker/staging.env PROXY_IP; 4.82 I904).
# TRUST_PROXY=false

# apps/api — login codes (ARCHITECTURE 8.1, 4.5). Restart the API after changing.
# (Thresholds and limits are settings, see above.)
# Channels: only "test" exists until TASK-026 (nothing is sent; refused when
# NODE_ENV=production).
# LOGIN_CODE_CHANNELS=test
# Make test channels report a delivery failure: whatsapp, sms or whatsapp,sms
# LOGIN_CODE_TEST_FAILING_CHANNELS=
# Show sent codes at GET /dev/login-codes. Default: true for development/test,
# false otherwise; refused when NODE_ENV=production.
# LOGIN_CODE_DEV_OUTBOX=true
# HMAC key for stored codes, >= 32 chars. Required outside development/test.
# LOGIN_CODE_HASH_SECRET=

# apps/api — browser origins of the web clients (CORS and cookie sessions;
# ARCHITECTURE 4.6). Comma-separated, scheme://host[:port], no path.
# Default in development/test: the Vite dev servers below (localhost and
# 127.0.0.1, ports 5175 and 5174); elsewhere: none — set them explicitly.
# SUPPLIER_WEB_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# ADMIN_WEB_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# apps/api — sessions (ARCHITECTURE 8.2, 4.6). Restart the API after changing.
# (Lifetimes and refresh limits are settings, see above.)
# HMAC key of access and refresh tokens, >= 32 chars. Required outside
# development/test. Changing it ends every session.
# SESSION_TOKEN_SECRET=

# apps/api — supplier cabinet and admin panel sign-in (ARCHITECTURE 8.1, 4.8).
# Restart the API after changing. (Step lifetimes, the second factor limits
# and the backup code count are settings, see above.)
# Encrypts administrators' TOTP secrets and keys backup code hashes, >= 32
# chars. Required outside development/test. Changing it invalidates every
# administrator's authenticator and backup codes (reset them with the
# operator command).
# ADMIN_TOTP_ENCRYPTION_KEY=

# apps/api — observability (ARCHITECTURE 15.3, 4.13). Restart the API and
# the worker after changing.
# Where error events go: a Sentry-compatible DSN of the receiver (SaaS or
# self-hosted). Unset (the default): nothing is sent and the application
# behaves as before. Personal data never leaves: every event goes through the
# sanitizer of the observability module. Real accounts: TASK-055.
# MONITORING_DSN=https://<key>@monitoring.example.kz/<project>
# Which deployment an event is tagged with. Default: NODE_ENV.
# MONITORING_ENVIRONMENT=staging
# Publish GET /metrics in the Prometheus text format. Default: on in
# development and test; in staging/production on only when METRICS_TOKEN is
# set (METRICS_ENABLED=true without a token there: the process won't start).
# METRICS_ENABLED=true
# When set, the collector must present it: Authorization: Bearer <token>
# (>= 16 chars, compared in constant time). Unset in development and test:
# the endpoint needs no token.
# METRICS_TOKEN=

# apps/api — AI (ARCHITECTURE 9.6, 4.20). Restart the API and the worker after
# changing. Everything that is a product choice — the daily budget
# (`ai_daily_budget_usd`), the model of each operation and its fallback
# (`ai_model_*`), the reservation per call, translation batch and retries — is
# a setting, not a variable: `operator settings:list`.
# Provider: "test" (calls nothing; development, tests and CI) or "openrouter" —
# the only real provider of the project (D-055). Unset: "openrouter" when
# OPENROUTER_API_KEY is set, otherwise "test"; production refuses "test" (its
# made-up texts would end up in the catalog), so production needs the key.
# AI_PROVIDER=test
# The OpenRouter API key (never commit a real one): one key for the whole
# project. Without it the test provider does the work and nothing is called.
# OPENROUTER_API_KEY=
# Where OpenRouter is. Development only — e.g. an address nothing answers at,
# to watch the retries and the dead letter queue of translation without
# touching the network. Unset: https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=
# What the test provider does (development and tests): ok | unavailable |
# rejected | no_private_provider | slow | incomplete | no_cost | empty |
# too_long | control_characters | wrong_language | invalid_output (TASK-061:
# the draft of a maintenance plan comes in another shape)
# AI_TEST_MODE=ok

# apps/api — messages to suppliers over WhatsApp (ARCHITECTURE 9.1, 4.35).
# Restart the API and the worker after changing. Everything that is a product
# choice — attempts, the pause between them, the length limit, how long values
# and webhook bodies are kept — is a setting: `operator settings:list`. The
# templates themselves are data in the code (SCREENS 8.5), not variables.
# The business is not verified in Meta yet, so nothing real is ever sent: with
# none of the WHATSAPP_* variables set the test channel runs (it sends nothing
# anywhere; what it "sent" is at GET /dev/messages in development).
# Channel: "test" or "whatsapp_cloud" (Meta's Cloud API, plain fetch, no SDK).
# Unset: whatsapp_cloud when the token, the number and the app secret are all
# set, otherwise test. Production refuses "test".
# MESSAGE_PROVIDER=test
# What the test channel does (development and tests): ok | unavailable |
# rate_limited | rejected | template_not_approved | no_whatsapp | outcome_unknown | slow
# MESSAGE_TEST_MODE=ok
# The permanent access token of the system user of the WhatsApp Business
# account (never commit a real one) and the id of the sending number.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# The Meta app secret: every event of the provider's webhook is checked with it
# (X-Hub-Signature-256). Development and tests have a fixed value so a signed
# webhook can be tried without Meta; anywhere else, unset means no webhook is
# accepted at all. >= 16 characters.
# WHATSAPP_APP_SECRET=
# The token Meta echoes back when the webhook subscription is confirmed
# (GET /webhooks/whatsapp). Unset outside development: it cannot be confirmed.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Where the Cloud API is. Development and tests only — e.g. an address nothing
# answers at, to watch retries and the dead letter queue without any network.
# Unset: https://graph.facebook.com
# WHATSAPP_API_BASE_URL=

# apps/api — push notifications to users (ARCHITECTURE 9.3, 4.79, 4.81;
# TASK-051, TASK-056). test — sends nothing, what it "sent" is at
# GET /dev/pushes; live — Android through FCM, iOS straight to APNs, and needs
# BOTH the FCM_* and the APNS_* below. Unset: live when both are whole, test
# otherwise. Production refuses "test". (TASK-051's "fcm" is now "live".)
# PUSH_PROVIDER=test
# What the test provider does: ok | unavailable | rejected | invalid_token | unknown | slow
# PUSH_TEST_MODE=ok
# Android: the Firebase project and its service account (the JSON key's
# project_id, client_email and private_key; the key on one line with \n for
# line breaks).
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# Development only: another address for FCM (to watch retries without the network).
# FCM_API_BASE_URL=
# iOS: the APNs key (.p8) of the Apple Developer team — its Key ID, the Team
# ID, the key itself (on one line with \n for line breaks), the app's bundle
# identifier (the apns-topic) and the environment: sandbox reaches development
# builds only, TestFlight and the App Store need production (production
# refuses sandbox).
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=kz.adclub.app
# APNS_ENVIRONMENT=sandbox
# Development only: another address for APNs (a local HTTP/2 server).
# APNS_API_URL=

# apps/api — a supplier's card subscription (ARCHITECTURE 9.4.2, 4.77; TASK-042).
# The card processor of Kazakhstan is not chosen yet (no contract, no API
# access), so the working provider is the test one: it charges nothing and its
# "page of the provider" is at GET /dev/payment/card in development. Production
# refuses "test". "card_kz" starts, but until its class exists every call
# answers "unavailable" (nobody is charged, nobody is paused).
# PAYMENT_PROVIDER=test
# What the test provider does (development and tests): ok | unavailable |
# outcome_unknown | declined | slow
# PAYMENT_TEST_MODE=ok
# Seals the tokens of cards (AES-256-GCM, >= 32 characters). Required outside
# development; losing it means every linked card has to be linked again.
# PAYMENT_TOKEN_ENCRYPTION_KEY=
# The secret the provider's webhook is signed with (POST /webhooks/payments).
# Development and tests have a fixed value; anywhere else, unset means no
# webhook is accepted. >= 16 characters.
# PAYMENT_WEBHOOK_SECRET=

# apps/admin-web, apps/supplier-web
VITE_API_URL=http://localhost:3000

# Deployed environments (TASK-055, ARCHITECTURE 4.82) are not configured
# here: addresses — infra/docker/staging.env, secrets — the encrypted
# infra/secrets/staging.env.sops (recipients in .sops.yaml). Outside
# development/test the API refuses to start when a secret has a value of
# this file or of compose.dev.yml (adclub-dev-secret, adclub-dev-master-key,
# the password "adclub", the adclub-dev-only-* stand-ins).
#
# The api image keeps its migrations at /repo/infra/migrations and says so
# with ADCLUB_MIGRATIONS_DIR; a checkout needs nothing.
# ADCLUB_MIGRATIONS_DIR=
#
# The Product Owner's private age key of staging.env.sops (decrypt/edit:
# `SOPS_AGE_KEY=$SOPS_AGE_KEY_STAGING_OWNER sops edit …`); CI's is the GitHub
# secret SOPS_AGE_KEY. Never committed; keep it in a password manager.
# SOPS_AGE_KEY_STAGING_OWNER=

# apps/mobile reads its own apps/mobile/.env — see apps/mobile/.env.example
