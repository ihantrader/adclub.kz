{
  "openapi": "3.1.0",
  "info": {
    "title": "adclub.kz API",
    "version": "0.1.0",
    "description": "Generated from @adclub/contracts — do not edit by hand. Changes must be additive (ARCHITECTURE 7.4)."
  },
  "tags": [
    {
      "name": "meta",
      "description": "Service state and client policy"
    },
    {
      "name": "auth",
      "description": "Sign-in with a one-time code"
    }
  ],
  "paths": {
    "/auth/login-code": {
      "post": {
        "operationId": "requestLoginCode",
        "summary": "Send a one-time login code to a Kazakhstan mobile number (WhatsApp, SMS as fallback)",
        "tags": [
          "auth"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ClientHeader"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "description": "Phone number and optional channel",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestLoginCodeBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The code was sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginCodeSentResponse"
                }
              }
            }
          },
          "426": {
            "$ref": "#/components/responses/ClientUpdateRequired"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/login-code/verify": {
      "post": {
        "operationId": "verifyLoginCode",
        "summary": "Check a login code; a correct code confirms the phone number and is spent",
        "tags": [
          "auth"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ClientHeader"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "description": "Phone number and the code",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyLoginCodeBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The phone number is confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginCodeVerifiedResponse"
                }
              }
            }
          },
          "426": {
            "$ref": "#/components/responses/ClientUpdateRequired"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness: answers while the API process is up",
        "tags": [
          "meta"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ClientHeader"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "responses": {
          "200": {
            "description": "The process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/meta/client-policy": {
      "get": {
        "operationId": "getClientPolicy",
        "summary": "Minimum supported client version per platform and the update message",
        "tags": [
          "meta"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ClientHeader"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "responses": {
          "200": {
            "description": "Current client policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientPolicyResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Readiness: state of PostgreSQL, Redis and S3",
        "tags": [
          "meta"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ClientHeader"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "responses": {
          "200": {
            "description": "Every dependency is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "426": {
            "$ref": "#/components/responses/ClientUpdateRequired"
          },
          "503": {
            "description": "At least one dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "details": {},
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ]
      },
      "ClientPlatform": {
        "type": "string",
        "enum": [
          "ios",
          "android",
          "supplier-web",
          "admin-web"
        ]
      },
      "ClientPolicyResponse": {
        "type": "object",
        "properties": {
          "platforms": {
            "type": "object",
            "properties": {
              "ios": {
                "$ref": "#/components/schemas/PlatformPolicy"
              },
              "android": {
                "$ref": "#/components/schemas/PlatformPolicy"
              },
              "supplier-web": {
                "$ref": "#/components/schemas/PlatformPolicy"
              },
              "admin-web": {
                "$ref": "#/components/schemas/PlatformPolicy"
              }
            },
            "required": [
              "ios",
              "android",
              "supplier-web",
              "admin-web"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "platforms",
          "message"
        ]
      },
      "ClientUpdateRequiredDetails": {
        "type": "object",
        "properties": {
          "platform": {
            "$ref": "#/components/schemas/ClientPlatform"
          },
          "clientVersion": {
            "type": "string"
          },
          "minSupportedVersion": {
            "type": "string"
          }
        },
        "required": [
          "platform",
          "clientVersion",
          "minSupportedVersion"
        ]
      },
      "DependencyCheck": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "latencyMs": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "NOT_FOUND",
          "CONFLICT",
          "INTERNAL_ERROR",
          "CLIENT_UPDATE_REQUIRED",
          "LOGIN_CODE_INVALID",
          "LOGIN_CODE_EXPIRED",
          "LOGIN_CODE_DELIVERY_FAILED",
          "RATE_LIMITED",
          "SERVICE_UNAVAILABLE"
        ]
      },
      "HealthCheckResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "enum": [
              "api",
              "worker"
            ]
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "timestamp"
        ]
      },
      "LoginCodeChannel": {
        "type": "string",
        "enum": [
          "whatsapp",
          "sms"
        ]
      },
      "LoginCodeInvalidDetails": {
        "type": "object",
        "properties": {
          "attemptsRemaining": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "attemptsRemaining"
        ]
      },
      "LoginCodeSentResponse": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "channel": {
            "$ref": "#/components/schemas/LoginCodeChannel"
          },
          "codeLength": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "resendAvailableAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "phone",
          "channel",
          "codeLength",
          "expiresAt",
          "resendAvailableAt"
        ]
      },
      "LoginCodeVerifiedResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "verified"
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "phone"
        ]
      },
      "PlatformPolicy": {
        "type": "object",
        "properties": {
          "minSupportedVersion": {
            "type": "string"
          }
        },
        "required": [
          "minSupportedVersion"
        ]
      },
      "RateLimitName": {
        "type": "string",
        "enum": [
          "login_code_resend_interval",
          "login_code_requests_per_phone",
          "login_code_requests_per_ip",
          "login_code_sms_per_phone_daily",
          "login_code_sms_per_ip_daily",
          "login_code_verifications_per_phone",
          "login_code_verify_delay"
        ]
      },
      "RateLimitedDetails": {
        "type": "object",
        "properties": {
          "limit": {
            "$ref": "#/components/schemas/RateLimitName"
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "limit",
          "retryAfterSeconds"
        ]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "postgres": {
                "$ref": "#/components/schemas/DependencyCheck"
              },
              "redis": {
                "$ref": "#/components/schemas/DependencyCheck"
              },
              "s3": {
                "$ref": "#/components/schemas/DependencyCheck"
              }
            },
            "required": [
              "postgres",
              "redis",
              "s3"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "RequestLoginCodeBody": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[+\\d\\s().-]+$",
            "examples": [
              "+7 701 123 45 67",
              "8 701 1234567"
            ]
          },
          "channel": {
            "$ref": "#/components/schemas/LoginCodeChannel"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerifyLoginCodeBody": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[+\\d\\s().-]+$",
            "examples": [
              "+7 701 123 45 67",
              "8 701 1234567"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "pattern": "^\\d+$"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      }
    },
    "parameters": {
      "ClientHeader": {
        "name": "X-Client",
        "in": "header",
        "required": false,
        "description": "Client platform and version: `mobile/<version> (ios|android)`, `supplier-web/<version>` or `admin-web/<version>`. Missing or malformed values are accepted and treated as an unknown client.",
        "schema": {
          "type": "string",
          "examples": [
            "mobile/1.4.2 (ios)",
            "admin-web/0.1.0"
          ]
        }
      },
      "AcceptLanguage": {
        "name": "Accept-Language",
        "in": "header",
        "required": false,
        "description": "Preferred language for server-provided texts: kk, ru or en (default ru).",
        "schema": {
          "type": "string",
          "examples": [
            "kk-KZ",
            "ru"
          ]
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Any failure, in the unified error format. `RATE_LIMITED` (429) also sets `Retry-After`; `details` is `RateLimitedDetails`",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse"
            }
          }
        }
      },
      "ClientUpdateRequired": {
        "description": "The client's version is below the supported minimum: code `CLIENT_UPDATE_REQUIRED`, `details` is `ClientUpdateRequiredDetails`",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse"
            }
          }
        }
      }
    }
  }
}
