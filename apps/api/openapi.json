    "/auth/session/refresh": {
      "post": {
        "operationId": "refreshSession",
        "summary": "Exchange a refresh token (body for the mobile app, HttpOnly cookie for web clients) for a new token pair",
        "tags": [
          "auth"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ClientHeader"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "description": "The refresh token (mobile), or an empty object (web, cookie)",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A new token pair",
            "content": {
