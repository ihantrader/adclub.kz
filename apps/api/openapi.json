    "/auth/sessions/{sessionId}": {
      "delete": {
        "operationId": "endSession",
        "summary": "End one of the account's own sessions; someone else's session answers like a missing one (404)",
        "tags": [
          "auth"
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          {
            "$ref": "#/components/parameters/ClientHeader"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "security": [
          {
            "sessionAccessToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "The session is ended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionsEndedResponse"
