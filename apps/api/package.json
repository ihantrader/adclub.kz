{
  "name": "@adclub/api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "operator": "tsx src/operator.ts",
    "start:operator": "node dist/operator.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node-pg-migrate up -m ../../infra/migrations --envPath ../../.env",
    "migrate:down": "node-pg-migrate down -m ../../infra/migrations --envPath ../../.env",
    "migrate:status": "tsx scripts/migrate-status.ts",
    "migrate:create": "node-pg-migrate create -j sql -m ../../infra/migrations --envPath ../../.env",
    "verify:graceful-shutdown": "tsx scripts/verify-graceful-shutdown.ts",
    "openapi:generate": "tsx scripts/openapi.ts generate",
    "openapi:check": "tsx scripts/openapi.ts check",
    "openapi:compat": "tsx scripts/check-openapi-compat.ts"
  },
  "dependencies": {
    "@adclub/contracts": "workspace:*",
    "@adclub/domain": "workspace:*",
    "@adclub/i18n": "workspace:*",
    "@aws-sdk/client-s3": "^3.1133.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adclub/config": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
