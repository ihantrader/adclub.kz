# Copy to apps/mobile/.env if needed (Expo loads .env from this folder only).
#
# API address used by the app. Leave unset in development: the app then
# calls port 3000 on the machine running the Expo dev server — the same
# address the phone already uses to load the app over Wi-Fi.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
