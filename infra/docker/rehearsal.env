# The staging stack rehearsed on a developer's machine (TASK-055; ARCHITECTURE
# 4.82): the same compose.staging.yml plus compose.staging.local.yml, the
# images built locally, the proxy with Caddy's own certificate for localhost
# and MinIO in place of the provider's S3. Run: infra/scripts/rehearsal.sh.
#
# One host, three ports — not three subdomains of `localhost`: a browser
# counts api.localhost and cabinet.localhost as different sites, and the
# session cookies are SameSite=Strict; ports do not make another site.
COMPOSE_PROJECT_NAME=adclub-rehearsal

API_SITE=localhost:8443
CABINET_SITE=localhost:8444
ADMIN_SITE=localhost:8445
API_PUBLIC_URL=https://localhost:8443
CABINET_PUBLIC_URL=https://localhost:8444
ADMIN_PUBLIC_URL=https://localhost:8445
SUPPLIER_WEB_ORIGINS=https://localhost:8444
ADMIN_WEB_ORIGINS=https://localhost:8445
ACME_EMAIL=ops@adclub.kz
# 0: a browser must not pin every port of `localhost` to HTTPS after the rehearsal.
HSTS_MAX_AGE=0
BODY_MAX_SIZE=25MB
DOCS_DIR=./proxy/docs

STACK_SUBNET=172.31.250.0/24
STACK_IP_RANGE=172.31.250.128/25
PROXY_IP=172.31.250.10

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=adclub-files
BACKUP_S3_BUCKET=adclub-backups
BACKUP_PREFIX=rehearsal
BACKUP_RETENTION_DAYS=14

PUSH_PROVIDER=test
