# The addresses and names of the staging stack (TASK-055; ARCHITECTURE 4.82)
# — compose interpolation only (compose.staging.yml), no secrets. Secrets are
# in infra/secrets/staging.env.sops. Another domain is one edit here.
COMPOSE_PROJECT_NAME=adclub-staging

# The sites of the front proxy (Caddy gets Let's Encrypt certificates for them).
# DNS: A records only, NO AAAA — the stack's Docker network has no IPv6, so an
# IPv6 client would reach Caddy through docker-proxy as the gateway address and
# every IPv6 user would share one per-IP limit (ARCHITECTURE 4.82 I916).
API_SITE=api.staging.adclub.kz
CABINET_SITE=cabinet.staging.adclub.kz
ADMIN_SITE=admin.staging.adclub.kz
API_PUBLIC_URL=https://api.staging.adclub.kz
CABINET_PUBLIC_URL=https://cabinet.staging.adclub.kz
ADMIN_PUBLIC_URL=https://admin.staging.adclub.kz
SUPPLIER_WEB_ORIGINS=https://cabinet.staging.adclub.kz
ADMIN_WEB_ORIGINS=https://admin.staging.adclub.kz
# Let's Encrypt writes about expiring certificates here.
ACME_EMAIL=ops@adclub.kz
HSTS_MAX_AGE=31536000
BODY_MAX_SIZE=25MB
# The club's documents (terms, privacy policy) served at CABINET/docs/…:
# replaced on the VM without a release.
DOCS_DIR=/opt/adclub/docs

# The stack's network; the API trusts X-Forwarded-For only from PROXY_IP.
STACK_SUBNET=172.30.0.0/24
STACK_IP_RANGE=172.30.0.128/25
PROXY_IP=172.30.0.10

# S3 of the provider (ps.kz, a data centre in Kazakhstan): the files bucket and the backups bucket.
# The endpoint and region come with the buckets (TASK-055 part B); keys are secrets.
S3_ENDPOINT=https://s3.example.invalid
S3_REGION=us-east-1
S3_BUCKET=adclub-staging-files
BACKUP_S3_BUCKET=adclub-staging-backups
BACKUP_PREFIX=staging
BACKUP_RETENTION_DAYS=14

# Push to phones: `test` until FCM and APNs keys exist (TASK-056 part B), then
# `live` with APNS_ENVIRONMENT=sandbox in the secrets.
PUSH_PROVIDER=test
