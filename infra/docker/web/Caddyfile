# The static server inside a web client image (TASK-055, ARCHITECTURE 4.82):
# plain HTTP on 8080 inside the stack's network — TLS, HSTS and compression
# are the front proxy's (infra/docker/proxy/Caddyfile). The headers of the
# page itself (CSP with the hash of this build's inline script) travel with
# the build: /etc/caddy/security.caddy is written by csp.mjs.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv/site
	import /etc/caddy/security.caddy

	# Hashed assets never change; everything else is checked every time, so a
	# new release is picked up on the next load (the cabinet's service worker
	# included).
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@revalidate not path /assets/*
	header @revalidate Cache-Control "no-cache"

	# A single-page application: a path that is not a file is the page.
	try_files {path} /index.html
	file_server
}
