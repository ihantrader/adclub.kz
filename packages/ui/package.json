{
  "name": "@adclub/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^19"
  },
  "scripts": {
    "build": "node scripts/copy-assets.mjs --clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "node scripts/copy-assets.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adclub/ui-core": "workspace:*",
    "@tabler/icons-react": "^3.46.0"
  },
  "devDependencies": {
    "@adclub/config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "fontkit": "^2.0.4",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
